# Yansen Agent Server environment defaults
# Override any variable before launching: YANSEN_PORT=9090 ./bin/yansen.sh

# HTTP server port
# YANSEN_PORT=8080

# API key for the default model provider
# MINIMAX_API_KEY=

# Model HTTP transport timeouts (seconds)
# YANSEN_MODEL_MAX_RETRIES=3
# YANSEN_CONNECT_TIMEOUT=30
# YANSEN_READ_TIMEOUT=900
# YANSEN_WRITE_TIMEOUT=30

# JVM options
# JAVA_OPTS="-Xms256m -Xmx512m"
