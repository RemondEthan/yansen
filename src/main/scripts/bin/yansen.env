# Yansen Agent Server environment defaults
# Override any variable before launching: YANSEN_PORT=9090 ./bin/yansen.sh
#
# SQLite model_config / agent_config may store ${ENV:default} placeholders literally;
# values are resolved at agent instantiation. Define matching env vars here.
# yansen.sh maps API_KEY → MINIMAX_API_KEY when MINIMAX_API_KEY is unset.

# HTTP server port
# YANSEN_PORT=8080

# API key for the default model provider
# MINIMAX_API_KEY=

# Model HTTP transport timeouts (seconds) — configure via SQLite model_config or
# PUT /api/config/model/{id} (not yansen.yml).
# YANSEN_MODEL_MAX_RETRIES=3
# YANSEN_CONNECT_TIMEOUT=30
# YANSEN_READ_TIMEOUT=900
# YANSEN_WRITE_TIMEOUT=30

# JVM options
# JAVA_OPTS="-Xms256m -Xmx512m"
API_KEY=sk-hIfxkhdRJ1wWzF2Evb51RuQDsy8LEQTqNkarDNeJcxipmYOi